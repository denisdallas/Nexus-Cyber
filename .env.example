# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Model identifier (defaults to gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# DATABASE_URL: PostgreSQL connection string (e.g., postgresql://postgres:password@localhost:5432/nexus)
# If omitted or unavailable, the studio falls back gracefully to high-performance local storage.
DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

PORT=3000
