# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Model identifier (defaults to gemini-2.0-flash)
GEMINI_MODEL="gemini-2.0-flash"

# Optional fallback providers. Keys remain server-side and are never sent to the browser.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct"
AI_PROVIDER_TIMEOUT_MS="7000"

# DATABASE_URL: PostgreSQL connection string (e.g., postgresql://postgres:password@localhost:5432/nexus)
# If omitted or unavailable, the studio falls back gracefully to high-performance local storage.
DATABASE_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

PORT=3000
